# Copy to `.env.local` for local builds, and add the same keys in your host's dashboard
# (Vercel → Settings → Environment Variables, or Netlify → Site configuration → Environment variables).
# `.env*` files (except this example) are git-ignored — never commit real values.

# ---------------------------------------------------------------------------
# PUBLIC (browser) — baked into the build. These are NOT secrets.
# ---------------------------------------------------------------------------

# Umami → Settings → Websites → your site → "Website ID" (a UUID). Leave empty to disable analytics.
VITE_UMAMI_WEBSITE_ID=
# Umami Cloud default. If you self-host Umami, use https://<your-umami-host>/script.js
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Optional: only count visits on these hostnames (comma-separated), so preview URLs don't skew stats.
VITE_UMAMI_DOMAINS=
# Set to "true" to ping the email-notification function once per visitor per day.
VITE_VISIT_NOTIFY=false
# Optional: override the function URL (defaults to /api/notify-visit on the same domain).
VITE_VISIT_NOTIFY_ENDPOINT=

# ---------------------------------------------------------------------------
# SERVER-ONLY (serverless function) — secrets. Set these in your host's dashboard.
# They have no VITE_ prefix, so Vite never exposes them to the browser.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com → API Keys). Free tier: 3,000 emails/month, 100/day.
RESEND_API_KEY=
# Where visit alerts go (comma-separate for several). With Resend's default sender this must be
# the email address you signed up to Resend with, unless you verify your own domain.
NOTIFY_EMAIL_TO=
# Sender. Keep the default until you've verified a domain in Resend.
NOTIFY_EMAIL_FROM=Portfolio <onboarding@resend.dev>
# Recommended: only accept pings from your live site (comma-separated, no trailing slash).
NOTIFY_ALLOWED_ORIGINS=
# Optional tuning.
NOTIFY_TIMEZONE=Asia/Kolkata
NOTIFY_COOLDOWN_SECONDS=60
NOTIFY_DAILY_LIMIT=50
